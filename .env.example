# ─── Core ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mizan:mizan@localhost:5434/mizan

# ─── Redis (Celery broker) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6381/0

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:7002","http://localhost:7003"]

# ─── File storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/mizan-uploads
MAX_FILE_SIZE_MB=200

# ─── Noesia ───────────────────────────────────────────────────────────────────
NOESIA_API_URL=http://localhost:8080
NOESIA_PAT=your-noesia-pat-here
NOESIA_PROFILE_SLUG=your-profile-slug

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:7004
QDRANT_HOST=                      # set for cloud: https://xxx.qdrant.io
QDRANT_API_KEY=                   # set for cloud

# ─── Ollama (query embeddings — must match Noesia ingest model) ───────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── LLM (analysis + summarization) — provider-agnostic via LiteLLM ──────────
LLM_PROVIDER=dashscope            # dashscope | zai | ollama | openai
LLM_MODEL=qwen-plus-2025-12-01
LLM_API_KEY=                      # generic key (or use provider-specific below)
LLM_BASE_URL=                     # override base URL

# Provider-specific keys
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# ─── Chat LLM (AI chat panel — tool-calling capable) ──────────────────────────
CHAT_LLM_PROVIDER=                # blank = falls back to LLM_PROVIDER
CHAT_LLM_MODEL=                   # blank = falls back to LLM_MODEL
CHAT_API_KEY=
CHAT_API_BASE=

# ─── Superadmin ───────────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@mizan.local
SUPERADMIN_PASSWORD=admin123
